# Frontend environment variables (Vite).
# Only variables prefixed with VITE_ are exposed to the client.
# Copy to `.env` and adjust as needed. All are optional in local dev.

# Backend API origin. Leave unset in local dev to use the Vite proxy (/api).
# In production (e.g. Vercel) set this to your deployed backend, including /api:
#   VITE_API_URL=https://your-backend.onrender.com/api
VITE_API_URL=

# Backend realtime (Socket.IO) origin. Leave unset in local dev.
# In production set this to the same backend host WITHOUT a path:
#   VITE_SOCKET_URL=https://your-backend.onrender.com
VITE_SOCKET_URL=

# Optional TURN server for WebRTC calls behind strict/symmetric NATs.
# STUN (Google) is always used; TURN is only needed for some networks.
VITE_TURN_URL=
VITE_TURN_USER=
VITE_TURN_PASS=
