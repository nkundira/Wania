# Server
PORT=5000
NODE_ENV=development

# Database
DATABASE_HOST=127.0.0.1
DATABASE_PORT=3306
DATABASE_USER=root
DATABASE_PASSWORD=
DATABASE_NAME=hospitality_academy
# Set to true for managed MySQL providers that require TLS (Aiven, PlanetScale, ...).
DATABASE_SSL=false

# Auth
JWT_SECRET=change-this-to-a-long-random-string-in-production
SESSION_SECRET=change-this-to-another-long-random-string
SESSION_MAX_AGE=604800

# URLs
# FRONTEND_URL may be a comma-separated list of allowed origins.
# *.vercel.app origins are allowed automatically in production.
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:5000

# WebRTC / TURN
TURN_SERVER_URL=
TURN_USERNAME=
TURN_CREDENTIAL=

# Uploads
UPLOAD_DIR=./src/uploads
MAX_UPLOAD_MB=10
