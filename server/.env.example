# Core
NODE_ENV=development
PORT=4000
CLIENT_URL=http://localhost:5173
PUBLIC_APP_URL=
PUBLIC_API_URL=

# PostgreSQL (Neon/Render/local). Use sslmode=require for hosted providers.
DATABASE_URL=postgres://postgres:password@localhost:5432/wania

# Secrets - generate with: openssl rand -hex 32
JWT_ACCESS_SECRET=replace-with-64-hex-chars
MEDIA_SIGNING_SECRET=replace-with-64-hex-chars
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_DAYS=30
COOKIE_SECURE=false

# Media storage. provider=local writes to server/uploads. provider=cloudinary uses private assets.
MEDIA_PROVIDER=local
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=50
MEDIA_URL_TTL_SECONDS=86400
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# AI assistant (OpenAI-compatible endpoint). Leave key empty to run in clearly-labelled offline mode.
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
AI_TIMEOUT_MS=25000

# WebRTC ICE. STUN works for most networks; TURN is required for strict NATs.
STUN_URLS=stun:stun.l.google.com:19302,stun:global.stun.twilio.com:3478
TURN_URL=
TURN_USERNAME=
TURN_CREDENTIAL=

# Optional transactional email (Resend). If unset, links are logged server-side in development.
# EMAIL_FROM must use a domain verified in Resend, e.g. WANIA <no-reply@client-domain.com>.
# For owner-only tests before domain verification, use WANIA <onboarding@resend.dev>.
RESEND_API_KEY=
EMAIL_FROM=
